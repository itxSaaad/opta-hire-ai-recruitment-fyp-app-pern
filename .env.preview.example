# Template only. Real local values are in ignored .env.preview.
# Vercel Preview is scoped to the develop Git branch at dev-opta-hire-fyp.vercel.app.
# Database, JWT, SMTP, and Stripe credentials intentionally match Production.
NODE_ENV=production
CLIENT_URL=https://dev-opta-hire-fyp.vercel.app
SERVER_URL=https://dev-opta-hire-fyp.vercel.app
CORS_ORIGIN=https://dev-opta-hire-fyp.vercel.app
VITE_CLIENT_URL=https://dev-opta-hire-fyp.vercel.app

DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_CA=<same-root-certificate-as-production-with-newlines-escaped>

JWT_ACCESS_TOKEN_SECRET=<same-as-production>
JWT_REFRESH_TOKEN_SECRET=<same-as-production>
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

NODEMAILER_SMTP_SERVICE=<same-as-production>
NODEMAILER_SMTP_HOST=<same-as-production>
NODEMAILER_SMTP_PORT=465
NODEMAILER_SMTP_SECURE=true
NODEMAILER_SMTP_EMAIL=<same-as-production>
NODEMAILER_SMTP_PASSWORD=<same-as-production>

STRIPE_PUBLISHABLE_KEY=<same-as-production>
STRIPE_SECRET_KEY=<same-as-production>
STRIPE_WEBHOOK_SECRET=<same-as-production>
VITE_STRIPE_PUBLISHABLE_KEY=<same-as-production>
VITE_GA_TRACKING_ID=<same-as-production>

FLASK_ENV=production
DEBUG=False
HOST=0.0.0.0
PROD_CLIENT_URL=https://dev-opta-hire-fyp.vercel.app
MAX_CANDIDATES=5
MIN_SIMILARITY=0.3
MODEL_STORAGE_PATH=data/models
WEIGHT_SKILLS=0.40
WEIGHT_EXPERIENCE=0.30
WEIGHT_EDUCATION=0.15
WEIGHT_INDUSTRY=0.10
WEIGHT_TEXT=0.05
ENABLE_CACHING=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_STORAGE=memory://
LOG_LEVEL=INFO
LOG_TO_FILE=false
ENABLE_COLOR_LOGS=false

# ML_SERVICES_URL is injected by Vercel's private service binding.
