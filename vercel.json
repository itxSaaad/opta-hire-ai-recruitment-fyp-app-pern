{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/scheduled-payouts",
      "schedule": "0 5 * * *"
    }
  ],
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "ml-services": {
      "root": "ml-services",
      "framework": "flask",
      "entrypoint": "app:app"
    },
    "server": {
      "root": "server",
      "framework": "node",
      "entrypoint": "app.js",
      "bindings": [
        {
          "type": "service",
          "service": "ml-services",
          "format": "url",
          "env": "ML_SERVICES_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
