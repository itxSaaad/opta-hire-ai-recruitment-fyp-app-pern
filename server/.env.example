# Copy to ignored .env and set your actual local credentials.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173,http://localhost:5000
ML_SERVICES_URL=http://localhost:5001/
DISABLE_SCHEDULED_PAYOUTS=true

# Use a dedicated database for schema work. The shared Supabase DB contains live data.
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres?sslmode=require
SUPABASE_DB_CA_FILE=certs/supabase-prod-ca.crt

JWT_ACCESS_TOKEN_SECRET=<local-secret>
JWT_REFRESH_TOKEN_SECRET=<local-secret>
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

NODEMAILER_SMTP_SERVICE=<service>
NODEMAILER_SMTP_HOST=<host>
NODEMAILER_SMTP_PORT=465
NODEMAILER_SMTP_SECURE=true
NODEMAILER_SMTP_EMAIL=<sender>
NODEMAILER_SMTP_PASSWORD=<credential>

STRIPE_PUBLISHABLE_KEY=<publishable-key>
STRIPE_SECRET_KEY=<secret-key>
STRIPE_WEBHOOK_SECRET=<webhook-secret>
DISABLE_SCHEDULED_PAYOUTS=true
