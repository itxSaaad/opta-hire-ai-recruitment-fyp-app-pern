# Template only. Real local values are in ignored .env.production.
NODE_ENV=production
CLIENT_URL=https://opta-hire-fyp.vercel.app
SERVER_URL=https://opta-hire-fyp.vercel.app
CORS_ORIGIN=https://opta-hire-fyp.vercel.app
VITE_CLIENT_URL=https://opta-hire-fyp.vercel.app

DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_CA=<PEM-root-certificate-with-newlines-escaped>

JWT_ACCESS_TOKEN_SECRET=<same-secret-in-production-and-preview>
JWT_REFRESH_TOKEN_SECRET=<same-secret-in-production-and-preview>
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

NODEMAILER_SMTP_SERVICE=<smtp-service>
NODEMAILER_SMTP_HOST=<smtp-host>
NODEMAILER_SMTP_PORT=465
NODEMAILER_SMTP_SECURE=true
NODEMAILER_SMTP_EMAIL=<verified-sender-email>
NODEMAILER_SMTP_PASSWORD=<smtp-credential>

STRIPE_PUBLISHABLE_KEY=<existing-publishable-key>
STRIPE_SECRET_KEY=<existing-secret-key>
STRIPE_WEBHOOK_SECRET=<existing-webhook-secret>
VITE_STRIPE_PUBLISHABLE_KEY=<same-publishable-key>
VITE_GA_TRACKING_ID=<measurement-id-or-empty>

FLASK_ENV=production
DEBUG=False
HOST=0.0.0.0
PROD_CLIENT_URL=https://opta-hire-fyp.vercel.app
MAX_CANDIDATES=5
MIN_SIMILARITY=0.3
MODEL_STORAGE_PATH=data/models
WEIGHT_SKILLS=0.40
WEIGHT_EXPERIENCE=0.30
WEIGHT_EDUCATION=0.15
WEIGHT_INDUSTRY=0.10
WEIGHT_TEXT=0.05
ENABLE_CACHING=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_STORAGE=memory://
LOG_LEVEL=INFO
LOG_TO_FILE=false
ENABLE_COLOR_LOGS=false
DISABLE_SCHEDULED_PAYOUTS=true

# ML_SERVICES_URL is injected by Vercel's private service binding.
